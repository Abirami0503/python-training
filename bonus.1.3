sales = [12000, 0, 8500, 15000, -200, 9800]
total = 0
i = 0

while i < len(sales):
    amount = sales[i]
    if amount <= 0:
        print("skipped invalid value", amount)
        i += 1
        continue
    total += amount
    print("addded", amount, "total", total)
    if total >30000:
        break
    i += 1
if total > 30000:
    print("target reached.", total)
else:
    print("target not reached")