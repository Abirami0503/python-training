import pandas as pd 

df = pd.read_csv("employees.csv")
print(df)

print("first 5 rows")
print(df.head())

print("DataFrame information:")
df.info()

print("Statistical Description:")
print(df.describe())

print("Employee Names:")
print(df[" name"])

print("Employee Names and Salaries:")
print(df[[" name", " salary"]])

print("Employees from Chennai:")
print(df.loc[df[" city"] == " Chennai", " name"])

print("First 3 employees - Names and Department:")
print(df.iloc[0:3, 1:3])

high_salary = df[df[" salary"] > 50000]

print("Salary above 50000:", high_salary[" name"].tolist())
print("Count:", len(high_salary))

it_employees = df[df[" department"] == " IT"]

print("IT department:", it_employees[" name"].tolist())
print("Count:", len(it_employees))