sales = [12000, 0, 8500, 15000, -200, 9800]
total = 0
for x in sales:
    if x <= 0:
        print("Skipped invalid value", x)
        continue

    total = total + x

    print("added", x, "total", total)

    if total > 30000:
        break

if total > 30000:
    print("Target reached", total)
else:
    print("target not reached")



