price = [ 500, 1200, 800, 2500, 300]

def apply_discount(price, discount=10):
    final_price = price - (price * discount / 100)
    return final_price

print("apply_discount(1000):", apply_discount(1000) )
print("apply_discount(1000, 25):", apply_discount(1000, 25))

def total(*args):
    return sum(args)

print("total(5, 10, 15):", total(5,10,15))

def describe(**kwargs):
    for key, value in kwargs.items():
        print(key, ":", value)

describe(name="Abirami", age=22, city="kanyakumari")

above_1000 = [price for price in price if price >1000]
print("Above 1000:", above_1000)

with_gst = list(map(lambda x: round(x*1.18, 2), price))
print("with GST:", with_gst)

below_1000 = list(filter(lambda x: x <1000, price))

print("below 1000:", below_1000)
