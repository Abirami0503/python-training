class InsufficientFundsError(Exception):
    pass

class Account:
    def __init__(self, owner, balance=0):       
        self.owner = owner
        self.balance = balance

    def deposit(self, amount):
        self.balance += amount

class SavingsAccount(Account):

    def __init__(self, owner, balance=0, min_balance=500):
        super().__init__(owner, balance)
        self.min_balance = min_balance

    def withdraw(self, amount):
        if self.balance - amount < self.min_balance:
            raise InsufficientFundsError(f"Insufficient Funds: balance {self.balance}, requested {amount}")
            
        self.balance -= amount
        print(self.owner, "withdrew", amount, "-> balance", self.balance)

priya = SavingsAccount("Priya", 1500)

try:
    priya.withdraw(1200)

except InsufficientFundsError as e:
    print("Error", e)

try:
    priya.withdraw(800)
except InsufficientFundsError as e:
    print("Error", e)

print(isinstance(priya, Account))

